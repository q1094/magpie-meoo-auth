{
  "name": "magpie-meoo-auth",
  "version": "1.4.0",
  "description": "Meoo 秒悟 (meoo.com) in OpenCode and Magpie: PKCE sign-in through a controlled browser, a project picker when the account has several, the daily 2000-point check-in, the account's points balance, and how long the web sign-in has left",
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    ".": "./opencode2.mjs"
  },
  "files": [
    "index.mjs",
    "web.mjs",
    "panel/session.html",
    "panel/session.js",
    "panel/session.css",
    "opencode.mjs",
    "opencode2.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/offline.test.mjs test/web.test.mjs"
  },
  "optionalDependencies": {
    "playwright-core": "^1.65.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-provider",
    "meoo",
    "秒悟",
    "openai-compatible"
  ],
  "license": "MIT",
  "author": {
    "name": "q1094",
    "url": "https://github.com/q1094"
  },
  "contributors": [
    {
      "name": "Fish-under-sea",
      "url": "https://github.com/Fish-under-sea"
    },
    {
      "name": "Chensy (elysia395)",
      "url": "https://github.com/elysia395"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q1094/magpie-meoo-auth.git"
  },
  "homepage": "https://github.com/q1094/magpie-meoo-auth#readme",
  "bugs": {
    "url": "https://github.com/q1094/magpie-meoo-auth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "name": "Meoo",
    "summary": {
      "en": "Meoo 秒悟 (meoo.com) in magpie: sign in with your own Meoo account and its gateway's models show up as one provider, with usage-billed tokens.",
      "zh": "用自己的 Meoo 秒悟账号使用 Meoo 网关上的模型——浏览器 PKCE 授权、复用本机登录态或项目服务 AK，模型目录实时同步。"
    },
    "panels": [
      {
        "slot": "provider",
        "file": "panel/session.html",
        "title": "Sign-in validity",
        "titles": {
          "zh": "登录态有效期"
        }
      }
    ],
    "icon": "data:image/png;base64,"
  }
}

